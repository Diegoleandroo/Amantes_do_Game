<mxfile><diagram name="03_arquitetura_limpa"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="JogoTeca – Arquitetura Limpa (como ficou no código)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=16;fontColor=#333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="460" height="24" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;4. Frameworks e drivers&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;FastAPI · SQLAlchemy · MySQL/SQLite · uvicorn · httpx · PyJWT · React + Vite&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="56" width="640" height="610" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;3. Adaptadores de interface&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;pastas rotas/ e adaptadores/&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="52" y="126" width="584" height="520" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;rotas/&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;HTTP → caso de uso&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="64" y="172" width="128" height="46" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;persistencia/&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;repositórios SQL&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="200" y="172" width="128" height="46" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;hash · token&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;scrypt · JWT&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="336" y="172" width="128" height="46" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;capas · IGDB&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;arquivos · HTTP&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="472" y="172" width="128" height="46" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;2. Casos de uso&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;pastas casos_de_uso/ e portas/&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="88" y="230" width="512" height="376" as="geometry"/></mxCell><mxCell id="c9" value="&lt;font style=&quot;font-size:12px&quot;&gt;Usuários&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="100" y="272" width="108" height="44" as="geometry"/></mxCell><mxCell id="c10" value="&lt;font style=&quot;font-size:12px&quot;&gt;Jogos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="220" y="272" width="108" height="44" as="geometry"/></mxCell><mxCell id="c11" value="&lt;font style=&quot;font-size:12px&quot;&gt;Avaliações&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="340" y="272" width="108" height="44" as="geometry"/></mxCell><mxCell id="c12" value="&lt;font style=&quot;font-size:12px&quot;&gt;Lançamentos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="460" y="272" width="108" height="44" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Portas (interfaces que o núcleo exige)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;RepositorioJogo · ArmazenamentoCapas · HashSenha · GeradorToken&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="100" y="326" width="480" height="52" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;1. Entidades&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;pasta dominio/ (regras que nunca mudam)&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="132" y="398" width="424" height="190" as="geometry"/></mxCell><mxCell id="c15" value="&lt;font style=&quot;font-size:12px&quot;&gt;Usuario · Jogo · Avaliacao · Lancamento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="148" y="444" width="392" height="46" as="geometry"/></mxCell><mxCell id="c16" value="&lt;font style=&quot;font-size:12px&quot;&gt;Genero · FaixaEtaria · Console · regras · erros&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="148" y="500" width="392" height="46" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Regra da dependência&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;O código só aponta para dentro.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Rotas e adaptadores conhecem os casos de uso;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;os casos de uso conhecem só as portas;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;o domínio não conhece ninguém.&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;(banco, web e JWT são detalhes trocáveis)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="70" width="330" height="150" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Como se liga&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Adaptador implementa a porta (traço) e a&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;composição acontece em rotas/deps.py&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;(Servicos): único lugar que escolhe qual&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;banco, hash e fonte externa usar.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="250" width="330" height="130" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Prova de que funciona&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Trocar SQLite por MySQL: só DATABASE_URL.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Trocar RAWG por IGDB: novo adaptador,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;casos de uso intactos.&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Testes dos casos de uso usam fakes, sem banco.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#333333;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="700" y="410" width="330" height="130" as="geometry"/></mxCell><mxCell id="c20" value="Cores: azul = núcleo · amarelo = portas · cinza = fora" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="700" y="566" width="353" height="19.5" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>