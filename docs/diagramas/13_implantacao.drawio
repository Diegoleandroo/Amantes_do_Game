<mxfile><diagram name="13_implantacao"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="JogoTeca – Implantação (como roda hoje e como irá para produção)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=16;fontColor=#333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="575" height="24" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;«dispositivo» Computador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;navegador&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="80" width="230" height="180" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Navegador&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;localhost:5173&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;roda o front-end&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="44" y="130" width="190" height="100" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;«dispositivo» Servidor / seu PC&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;hoje: iniciar.bat&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="320" y="80" width="340" height="430" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Front-end&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;Vite (dev) · arquivos estáticos (prod)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="340" y="13