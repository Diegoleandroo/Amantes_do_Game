<mxfile><diagram name="04_tipo_de_arquitetura"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="JogoTeca – Tipo de arquitetura: cliente–servidor, API em camadas (monólito modular)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=16;fontColor=#333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="24" y="16" width="742" height="24" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Cliente&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;navegador&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="24" y="70" width="200" height="150" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Front-end SPA&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;React + TypeScript&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;Vite · react-router&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="168" height="84" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Servidor – API (um só processo)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;FastAPI&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="360" height="330" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Apresentação&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;rotas · middlewares de segurança&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="320" height="56" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Aplicação&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;casos de uso&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="180" width="320" height="56" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Domínio&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;entidades e regras&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="250" width="320" height="56" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Infraestrutura&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;repositórios · hash · JWT · capas&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="320" width="320" height="56" as="geometry"/></mxCell><mxCell id="c9" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="166" as="sourcePoint"/><mxPoint x="480" y="180" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="480" y="236" as="sourcePoint"/><mxPoint x="480" y="250" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" style="endArrow=classic;html=1;rounded=0;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="560" y="320" as="sourcePoint"/><mxPoint x="560" y="306" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="implementa portas" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="566" y="303" width="114" height="19" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Dados&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="776" y="70" width="214" height="260" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Pasta de capas&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;arquivos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="792" y="110" width="182" height="70" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Banco de dados&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;SQLite (padrão)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;MySQL (produção)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="792" y="200" width="182" height="90" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="322" as="sourcePoint"/><mxPoint x="792" y="145" as="targetPoint"/><Array as="points"><mxPoint x="700" y="322"/><mxPoint x="700" y="145"/></Array></mxGeometry></mxCell><mxCell id="c17" value="lê/grava" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="704" y="125" width="60" height="19" as="geometry"/></mxCell><mxCell id="c18" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="348" as="sourcePoint"/><mxPoint x="792" y="245" as="targetPoint"/><Array as="points"><mxPoint x="730" y="348"/><mxPoint x="730" y="245"/></Array></mxGeometry></mxCell><mxCell id="c19" value="SQL" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="736" y="249" width="30" height="19" as="geometry"/></mxCell><mxCell id="c20" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="208" y="162" as="sourcePoint"/><mxPoint x="300" y="162" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="HTTPS" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontColor=#333;" vertex="1" parent="1"><mxGeometry x="232" y="136" width="43" height="19.5" as="geometry"/></mxCell><mxCell id="c22" value="JSON" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#333;" vertex="1" parent="1"><mxGeometry x="236" y="169" width="36" height="19" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Processo agendado (outro processo)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:11px&quot;&gt;mesmo código, sem HTTP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;dashed=1;verticalAlign=top;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="300" y="450" width="360" height="130" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Rotina de lançamentos&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;python -m app.rotina_lancamentos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b1ddf0;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="320" y="494" width="320" height="60" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Serviços externos&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;Twitch OAuth (token)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;IGDB (jogos, capas)&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#555555&quot; style=&quot;font-size:12px&quot;&gt;internet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#333333;verticalAlign=middle;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="776" y="440" width="214" height="140" as="geometry"/></mxCell><mxCell id="c26" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="505" as="sourcePoint"/><mxPoint x="792" y="270" as="targetPoint"/><Array as="points"><mxPoint x="752" y="505"/><mxPoint x="752" y="270"/></Array></mxGeometry></mxCell><mxCell id="c27" value="SQL" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="758" y="407" width="30" height="19" as="geometry"/></mxCell><mxCell id="c28" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="640" y="535" as="sourcePoint"/><mxPoint x="776" y="535" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c29" value="HTTPS" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontColor=#333;" vertex="1" parent="1"><mxGeometry x="686" y="514" width="43" height="19.5" as="geometry"/></mxCell><mxCell id="c30" value="Cliente–servidor: o navegador só pede e mostra; regras e dados ficam no servidor. Não é microsserviço: a API é um deploy só." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="24" y="596" width="796" height="19.5" as="geometry"/></mxCell><mxCell id="c31" value="A rotina é um 2º processo do mesmo código: grava os lançamentos no banco e a API só lê. O navegador busca as imagens de capa direto do IGDB." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;fontSize=11.5;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="24" y="614" width="897" height="19.5" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>