# Copie para ".env" (mesma pasta do docker-compose.yml) e preencha. O arquivo .env NUNCA vai para o GitHub.
# Só é necessário para a rotina de lançamentos (IGDB / Twitch):
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Senhas do banco (troque por outras, só suas):
MYSQL_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
# Segredo do login (32+ caracteres). Gere um com:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=troque-por-um-segredo-longo-e-aleatorio-de-32-ou-mais-caracteres
